# Copy to .env and fill in real values. NEVER commit the real .env.

# Application
APP_ENV=development
DEBUG=true

# Database (PostgreSQL + PostGIS)
DATABASE_URL=postgresql+psycopg://limcity:limcity@localhost:5432/limcity

# Meta WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=change-me
WHATSAPP_ACCESS_TOKEN=change-me
WHATSAPP_APP_SECRET=change-me
# Phone number id (Meta > WhatsApp > API Setup); required to send outbound replies.
WHATSAPP_PHONE_NUMBER_ID=change-me
WHATSAPP_GRAPH_VERSION=v25.0

# AI / Vision classifier. The /admin panel can override these without a restart.
# Providers: gemini (placeholder), openai, ollama, cursor (Cursor CLI via the worker).
AI_PROVIDER=cursor
AI_API_KEY=change-me
OPENAI_MODEL=gpt-5

# Presentation mode. Photos are saved and shown on the map immediately.
# Classification runs in the worker (started by run.py) instead of the webhook.
DEMO_MODE=true

# Cursor CLI classifier (command on PATH, usually `agent` from the Cursor CLI).
CURSOR_CLI_BIN=agent
CURSOR_MODEL=
CURSOR_TIMEOUT_SECONDS=180

# Saved report photos and the admin runtime config (both gitignored).
IMAGE_STORAGE_DIR=data/report-images
RUNTIME_CONFIG_PATH=data/runtime_config.json

# Local Ollama vision model (requires Ollama running locally and the model pulled)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3
OLLAMA_TIMEOUT_SECONDS=180

# Telegram Bot API (create via @BotFather)
TELEGRAM_BOT_TOKEN=change-me
# Optional webhook secret (recommended in production); leave as change-me to skip locally.
TELEGRAM_WEBHOOK_SECRET=change-me
