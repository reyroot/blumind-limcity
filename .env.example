# Copy to .env and fill in real values. NEVER commit the real .env.

# Application
APP_ENV=development
DEBUG=true

# Database (PostgreSQL + PostGIS)
DATABASE_URL=postgresql+psycopg://limcity:limcity@localhost:5432/limcity

# Meta WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=change-me
WHATSAPP_ACCESS_TOKEN=change-me
WHATSAPP_APP_SECRET=change-me
# Phone number id (Meta > WhatsApp > API Setup); required to send outbound replies.
WHATSAPP_PHONE_NUMBER_ID=change-me
WHATSAPP_GRAPH_VERSION=v25.0

# AI / Vision classifier (third-party provider for MVP)
AI_PROVIDER=gemini
AI_API_KEY=change-me

# Telegram Bot API (create via @BotFather)
TELEGRAM_BOT_TOKEN=change-me
# Optional webhook secret (recommended in production); leave as change-me to skip locally.
TELEGRAM_WEBHOOK_SECRET=change-me
